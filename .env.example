# Finance Agent model runtime configuration.

# Easy chat model.
FINANCE_CHAT_FAST_MODEL_NAME=
FINANCE_CHAT_FAST_BASE_URL=
FINANCE_CHAT_FAST_API_KEY=
FINANCE_CHAT_FAST_TIMEOUT_SECONDS=30
FINANCE_CHAT_FAST_MAX_RETRIES=2

# Medium chat model.
FINANCE_CHAT_BALANCED_MODEL_NAME=
FINANCE_CHAT_BALANCED_BASE_URL=
FINANCE_CHAT_BALANCED_API_KEY=
FINANCE_CHAT_BALANCED_TIMEOUT_SECONDS=45
FINANCE_CHAT_BALANCED_MAX_RETRIES=2

# Hard chat and task-parser model.
FINANCE_CHAT_STRONG_MODEL_NAME=
FINANCE_CHAT_STRONG_BASE_URL=
FINANCE_CHAT_STRONG_API_KEY=
FINANCE_CHAT_STRONG_TIMEOUT_SECONDS=90
FINANCE_CHAT_STRONG_MAX_RETRIES=2

# Medium factor-research model.
FINANCE_RESEARCH_BALANCED_MODEL_NAME=
FINANCE_RESEARCH_BALANCED_BASE_URL=
FINANCE_RESEARCH_BALANCED_API_KEY=
FINANCE_RESEARCH_BALANCED_TIMEOUT_SECONDS=90
FINANCE_RESEARCH_BALANCED_MAX_RETRIES=2

# Hard factor-research and task-parser model.
FINANCE_RESEARCH_STRONG_MODEL_NAME=
FINANCE_RESEARCH_STRONG_BASE_URL=
FINANCE_RESEARCH_STRONG_API_KEY=
FINANCE_RESEARCH_STRONG_TIMEOUT_SECONDS=180
FINANCE_RESEARCH_STRONG_MAX_RETRIES=2

# Local router classifier model.
ROUTER_CLASSIFIER_MODEL_PATH=
ROUTER_CLASSIFIER_MODEL_VERSION=router-v1

# Web search API for chat answers.
FINANCE_WEB_SEARCH_API_URL=
FINANCE_WEB_SEARCH_API_KEY=
FINANCE_WEB_SEARCH_WORKSPACE=default
FINANCE_WEB_SEARCH_SERVICE_ID=ops-web-search-001
FINANCE_WEB_SEARCH_QUERY_REWRITE=true
FINANCE_WEB_SEARCH_TOP_K=5
FINANCE_WEB_SEARCH_CONTENT_TYPE=snippet
FINANCE_WEB_SEARCH_WAY=pro
FINANCE_WEB_SEARCH_TIMEOUT_SECONDS=30
FINANCE_WEB_SEARCH_MAX_RETRIES=1

# Tushare market data fetch.
TUSHARE_TOKEN=
# Optional custom Tushare-compatible endpoint. Leave empty for official endpoint.
TUSHARE_HTTP_URL=
DATA_FETCH_DB_PATH=data/market_data.sqlite3
DATA_FETCH_START_DATE=20100101
DATA_FETCH_END_DATE=
# L=listed, D=delisted, P=paused. Keeping all three avoids survivorship bias.
DATA_FETCH_STOCK_STATUSES=L,D,P
DATA_FETCH_SCHEDULER_TIME=20:00
DATA_FETCH_REQUEST_SLEEP_SECONDS=0.12
DATA_FETCH_RETRY_COUNT=3
